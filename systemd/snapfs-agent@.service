[Unit]
Description=SnapFS Agent (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=snapfs
Group=snapfs
EnvironmentFile=-/etc/snapfs/agent-%i.env
WorkingDirectory=/var/lib/snapfs/%i
ExecStart=/bin/sh -lc 'exec "$SNAPFS_BIN" agent'
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
