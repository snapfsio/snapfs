[Unit]
Description=SnapFS Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=snapfs
Group=snapfs
EnvironmentFile=-/etc/snapfs/agent.env
WorkingDirectory=/var/lib/snapfs
ExecStart=__SNAPFS_EXEC__ agent
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
